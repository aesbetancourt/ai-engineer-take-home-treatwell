{
  "name": "@venue/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "yarn db:migrate && tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:check": "tsx src/db/check-cli.ts",
    "db:migrate": "tsx src/db/migrate-cli.ts",
    "db:seed": "tsx src/db/seed-cli.ts"
  },
  "dependencies": {
    "@fastify/cors": "11.3.0",
    "@venue/contract": "workspace:*",
    "better-sqlite3": "13.0.3",
    "drizzle-orm": "0.45.3",
    "fastify": "5.12.5",
    "lodash": "^4.17.21",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/lodash": "^4.17.0",
    "@types/node": "^22.0.0",
    "drizzle-kit": "0.31.11",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "^7.0.0",
    "vitest": "5.0.3"
  }
}
